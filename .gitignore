## ── ASP.NET Core / .NET ──────────────────────────────────────────────────────

# Build output
bin/
obj/

# User Secrets (NEVER commit – store DB passwords, API keys, SMTP creds here)
# Location: %APPDATA%\Microsoft\UserSecrets\<project-guid>\secrets.json
# Add secrets with: dotnet user-secrets set "Key" "Value"
**/secrets.json

# Local appsettings overrides (create this file locally to override appsettings.json)
appsettings.Local.json
appsettings.*.Local.json

# Entity Framework migrations (optional – uncomment if auto-generated)
# **/Migrations/

# NuGet
*.nupkg
*.snupkg
.nuget/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/
*.DotSettings.user

# Publish output
publish/
**/publish/

# Test results
TestResults/
coverage/

